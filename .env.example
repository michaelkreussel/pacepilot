DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data
GARMIN_TOKEN_DIR=./data/garmin-tokens
SYNC_DAYS=14
HEALTH_SYNC_OVERLAP_DAYS=7
SYNC_INTERVAL_MINUTES=60
GARMIN_CALL_DELAY_SECONDS=0.75
SCHEDULER_ENABLED=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=
# Set to true when PacePilot is served over HTTPS.
SESSION_HTTPS_ONLY=false

# Application login. Configure either or both providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: verified email allowed to adopt the existing pre-login user and its data.
AUTH_LEGACY_USER_EMAIL=

# Optional for token refresh in unattended operation.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# OpenRouter access for the stateless Agno training coach.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
