DATABASE_URL=sqlite:///./data/app.db
ENVIRONMENT=development
DATA_DIR=./data
GARMIN_TOKEN_DIR=./data/garmin-tokens
HEALTH_SYNC_OVERLAP_DAYS=7
SYNC_INTERVAL_MINUTES=60
GARMIN_CALL_DELAY_SECONDS=0.75
SCHEDULER_ENABLED=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=
# Set ENVIRONMENT=production and this to true when PacePilot is served publicly over HTTPS.
SESSION_HTTPS_ONLY=false
# Public base URL of the app (e.g. https://example.com).
# Required behind a reverse proxy so OAuth redirect URIs match the provider whitelist.
# PUBLIC_BASE_URL=https://example.com

# Application login. Configure either or both providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional for token refresh in unattended operation.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# OpenRouter access for the stateless Agno training coach.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
