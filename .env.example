DATABASE_URL=sqlite:///./data/app.db
ENVIRONMENT=development
DATA_DIR=./data
GARMIN_TOKEN_DIR=./data/garmin-tokens
HEALTH_SYNC_OVERLAP_DAYS=7
SYNC_INTERVAL_MINUTES=60
GARMIN_SYNC_WORKERS=2
GARMIN_CALL_DELAY_SECONDS=0.75
GARMIN_ACTIVITY_INITIAL_ENRICHMENT=0
GARMIN_ACTIVITY_ENRICHMENT_PER_SYNC=5
GARMIN_RATE_LIMIT_COOLDOWN_SECONDS=300
GARMIN_OPERATION_STALE_MINUTES=15
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO
MUTATION_RATE_LIMIT_PER_MINUTE=120
COACH_RATE_LIMIT_PER_MINUTE=12
AUTH_RATE_LIMIT_PER_MINUTE=20
ACCOUNT_EXPORT_RATE_LIMIT_PER_MINUTE=2
# Optional bearer token (minimum 32 characters) for GET /api/metrics.
# METRICS_BEARER_TOKEN=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=
# Set ENVIRONMENT=production and this to true when PacePilot is served publicly over HTTPS.
SESSION_HTTPS_ONLY=false
# Public base URL of the app (e.g. https://example.com).
# Required behind a reverse proxy so OAuth redirect URIs match the provider whitelist.
# PUBLIC_BASE_URL=https://example.com

# Application login. Configure either or both providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional for token refresh in unattended operation.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# OpenRouter access for the LangChain health-data coach.
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Future coach workout capabilities. These do not affect manual workout or Garmin flows.
COACH_WORKOUT_PROPOSALS_ENABLED=false
COACH_GARMIN_SYNC_ENABLED=false
COACH_DAILY_ADAPTATION_ENABLED=false
COACH_PLAN_GENERATION_ENABLED=false
# Development-only test switch. Production rejects false.
COACH_PLANNER_HISTORY_GATES_ENABLED=true
# Development-only execution override for threshold/VO2max templates.
COACH_DEFERRED_QUALITY_TEMPLATES_ENABLED=false
# Optional comma-separated internal rollout cohort. Empty means all authenticated users.
COACH_ROLLOUT_USER_IDS=
